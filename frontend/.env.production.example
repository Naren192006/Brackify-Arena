# ===========================================================================
# Brackify Arena — Frontend Environment Variables (Production / Vercel)
# ===========================================================================

# Backend API URL (Production FastAPI server URL, e.g. on Render or Railway)
NEXT_PUBLIC_API_URL=https://api.brackifyarena.com

# Supabase Production Project
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_anon_key...

# Razorpay Production Key ID (Prefix MUST start with rzp_live_)
# NEVER put secret keys in NEXT_PUBLIC_ variables!
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Production Site URL (For OAuth callbacks, canonical links, and OpenGraph tags)
NEXT_PUBLIC_APP_URL=https://brackifyarena.com
NEXT_PUBLIC_SITE_NAME="Brackify Arena"

