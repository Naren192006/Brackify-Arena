# ===========================================================================
# Brackify Arena — Production Environment Variables Reference
# ===========================================================================

# Application & Environment
APP_NAME="Brackify Arena"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Primary Database (Managed PostgreSQL — Supabase / Render / AWS RDS)
DATABASE_URL=postgresql+asyncpg://postgres:1R0xa4fTjPvskaTn@db.zzeuvelusejxyrkdqzxu.supabase.co:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis (Managed Redis — Upstash / Render / Redis Cloud)
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379
REDIS_ENABLED=true

# Security & Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=generate-a-64-character-random-hex-key-here-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS & Trusted Hosts (Explicit production domains only — NO wildcards)
CORS_ORIGINS=https://brackifyarena.com,https://brackifyarena.vercel.app
ALLOWED_HOSTS=api.brackifyarena.com,*.onrender.com,*.railway.app

# URLs & OAuth
FRONTEND_URL=https://brackifyarena.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.brackifyarena.com/api/v1/auth/google/callback

# Supabase Production Keys (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROD-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_anon...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_service_role...
SUPABASE_JWT_SECRET=xhNQfc8H6N3djfB5tphLUBghPIfFwzg6IF/7iCwsvKimsm2RXY4S7W8WNhQ22yb/Rw1MbfV+TCWKHff8Bh9rcQ==

# Razorpay (Live Production Credentials — MUST start with rzp_live_)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Vercel Environment Variables)
NEXT_PUBLIC_API_URL=https://api.brackifyarena.com
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROD-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_anon...
