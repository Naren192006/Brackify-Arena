# ===========================================================================
# Brackify Arena — Development Environment Variables
# ===========================================================================

# Application & Environment
APP_NAME="Brackify Arena"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Primary Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://tournament:tournament@localhost:5432/tournament
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Security & Secrets
SECRET_KEY=dev-secret-change-in-production-min-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS & Trusted Hosts
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# URLs & OAuth
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Supabase (Server-side service role key — NEVER share with browser)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dev_service_role...
SUPABASE_JWT_SECRET=xhNQfc8H6N3djfB5tphLUBghPIfFwzg6IF/7iCwsvKimsm2RXY4S7W8WNhQ22yb/Rw1MbfV+TCWKHff8Bh9rcQ==

# Razorpay (Payment Gateway — Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
